# QORTEX · conector NetSuite de SOLO LECTURA (OAuth1 TBA)
# Solo referencias op://. Los valores viven en 1Password, bóveda Quamtex-REA.
# Uso: make extraer  (= op run --env-file=.env.example -- uv run qortex extraer)
#
# El token debe pertenecer a un rol EXCLUSIVO de QORTEX, sin permisos de
# transacción (Acta §8, ADR-001). No reusar el rol del Tomador de Pedido.

NS_ACCOUNT=op://Quamtex-REA/qortex-netsuite/account_id
NS_CONSUMER_KEY=op://Quamtex-REA/qortex-netsuite/consumer_key
NS_CONSUMER_SECRET=op://Quamtex-REA/qortex-netsuite/consumer_secret
NS_TOKEN_ID=op://Quamtex-REA/qortex-netsuite/token_id
NS_TOKEN_SECRET=op://Quamtex-REA/qortex-netsuite/token_secret
NS_LOCATION_ID=op://Quamtex-REA/qortex-netsuite/location_id_houston
